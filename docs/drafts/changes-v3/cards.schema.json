        "basis": {
          "enum": [
            "scholarly_dictionary",
            "slang_dictionary",
            "crowd_dictionary",
            "literature",
            "media",
            "testimony"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "community"
              }
            }
          },
          "then": {
            "required": [
              "basis"
            ]
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "not": {
                  "const": "community"
                }
              }
            }
          },
          "then": {
            "not": {
